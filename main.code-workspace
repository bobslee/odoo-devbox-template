{
	"folders": [
		{
			"name": "dev-odoo",
			"path": ".."
		},
		{
			"name": "addons",
			"path": "addons"
		}
	],
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Odoo: Start Server",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder:dev-odoo}/dev-odoo-19/odoo/odoo-bin",
				"args": [
					"--addons-path=${workspaceFolder:dev-odoo}/dev-odoo-19/odoo/addons,${workspaceFolder:dev-odoo}/dev-odoo-19/enterprise,${workspaceFolder:dev-odoo}/dev-odoo-19/addons"
				],
				"python": "${workspaceFolder:dev-odoo}/dev-odoo-19/.venv/bin/python",
				"cwd": "${workspaceFolder:dev-odoo}/dev-odoo-19",
				"console": "integratedTerminal"
			},
			{
				"name": "Odoo: Attach Debugger",
				"type": "debugpy",
				"request": "attach",
				"connect": {
					"host": "localhost",
					"port": 5678
				}
			}
		]
	}
}
